generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum UserRole {
  USER
  EDITOR
  ADMIN
}

enum PostStatus {
  DRAFT
  REVIEW
  PUBLISHED
}

enum PostType {
  NEWS
  PREVIEW
  REVIEW
  GUIDE
}

enum DeckVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum RuleSourceType {
  OFFICIAL_FAQ
  OFFICIAL_RULES
  COMMUNITY_EXPLAINER
}

enum CardLanguage {
  PT_BR
  EN
}

enum HostedEventStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Fase C: status de uma rodada dentro de um HostedEvent.
enum HostedEventRoundStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

// Fase C: resultado de um confronto. BYE é o caso sem participantB (folga --
// vitória automática pro participantA, sem afetar as estatísticas de ninguém
// mais). O MVP é sempre lançado manualmente pelo Hoster; o schema não impede
// que um pareamento automático (Swiss) venha a preencher essas mesmas tabelas
// no futuro.
enum HostedEventMatchResult {
  PENDING
  PLAYER_A_WIN
  PLAYER_B_WIN
  DRAW
  BYE
}

enum SetKind {
  BOOSTER_PACK
  STARTER_DECK
  ACCESSORIES
  PREMIUM_BANDAI
  OTHER
}

// Classificação tática de evento -- alimenta as abas da Central de Eventos
// (TournamentsPage) inspiradas no ecossistema Egman Events / Mobile Suit Arena,
// adaptado pra terminologia PT-BR (ver PLANO_METAGAME_TORNEIOS_TELEMETRIA.md §3).
// Aplica tanto a Tournament (report retroativo) quanto a HostedEvent (ao vivo).
enum TournamentTier {
  LARGE_OFFICIAL
  SMALL_OFFICIAL
  UNOFFICIAL
  RANKED
  TEAM
}

enum CardType {
  UNIT
  PILOT
  COMMAND
  COMMAND_PILOT
  BASE
  RESOURCE
  EX_BASE
  EX_RESOURCE
  UNIT_TOKEN
}

enum TaxonomyKind {
  TRAIT
  SOURCE_TITLE
}

enum CardRelationType {
  PILOT_OF
  SUPPORTS
  UPGRADE_OF
  SAME_ARCHETYPE
  STORY_RELATED
}

model User {
  id                    String       @id @default(cuid())
  email                 String       @unique
  googleId              String?      @unique
  displayName           String
  username              String       @unique
  passwordHash          String?
  role                  UserRole     @default(USER)
  isActive              Boolean      @default(true)
  isHoster              Boolean      @default(false)
  // sobe a cada troca/redefinição de senha; tokens com outra versão deixam de valer (server/sessionState.ts)
  tokenVersion          Int          @default(0)
  preferredCardLanguage CardLanguage @default(PT_BR)
  // idioma da interface: "pt-BR" ou "en" (texto das cartas é o campo acima, separado)
  preferredSiteLanguage String       @default("pt-BR")
  bio                   String?      @db.Text
  avatarUrl             String?
  preferredTheme        String?      @default("dark")
  // Confirmação de e-mail (link enviado no cadastro). Login com Google já chega confirmado.
  emailVerifiedAt       DateTime?
  // Apoio comunitário (doação / insígnia de Apoiador)
  isSupporter           Boolean      @default(false)
  supporterSince        DateTime?
  supporterMessage      String?      @db.Text
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  authTokens              AuthToken[]
  decks                   Deck[]
  posts                   Post[]
  binders                 CardBinder[]
  tournamentEntries       TournamentEntry[]
  hostedEvents            HostedEvent[]
  deckSnapshots           DeckSnapshot[]
  hostedEventParticipants HostedEventParticipant[]
  deckChangeLogsMade      TournamentEntryDeckChangeLog[]
  deckLikes               DeckLike[]
  deckViews               DeckView[]

  // Rede Social & Comunidade (Anaheim Hub)
  followers               UserFollow[]                   @relation("UserFollowers")
  following               UserFollow[]                   @relation("UserFollowing")
  friendshipsRequested    UserFriendship[]               @relation("FriendshipRequested")
  friendshipsReceived     UserFriendship[]               @relation("FriendshipReceived")
  sentPilotMails          PilotMailMessage[]             @relation("SentPilotMail")
  receivedPilotMails      PilotMailMessage[]             @relation("ReceivedPilotMail")
  reportsCreated          MailReport[]                   @relation("ReportsCreated")
  reportsAgainst          MailReport[]                   @relation("ReportsAgainst")
  notificationsReceived   Notification[]                 @relation("NotificationRecipient")
  notificationsTriggered  Notification[]                 @relation("NotificationActor")

  // Artigos: Curtidas e Comentários
  postLikes               PostLike[]
  postComments            PostComment[]
  postCommentLikes        PostCommentLike[]
}

// Tokens de uso único enviados por e-mail (confirmação de e-mail e recuperação de senha). Só o hash
// SHA-256 fica no banco: o token em si existe apenas no link do e-mail.
enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// Temporada real de metagame -- agrupa um lançamento de coleção principal com os
// produtos que entram na mesma "era" competitiva (ex: GD05 + os 4 starter decks que
// saem depois dela, ainda dentro da mesma season). Só uma Season tem isCurrent=true
// por vez (garantido em aplicação, ver PUT /api/seasons/:id/set-current); tudo que
// não pertence à season atual passa a ser tratado como legado nas leituras de
// metagame (StatsPage "Competitivo"). Também é o ponto de apoio pra um futuro
// sistema de rotação (cartas legais só a partir de X): a relação já existe.
model Season {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  startDate DateTime?
  endDate   DateTime?
  isCurrent Boolean   @default(false)
  notes     String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  cardSets     CardSet[]
  tournaments  Tournament[]
  hostedEvents HostedEvent[]

  @@index([isCurrent])
}

model CardSet {
  id                    String    @id @default(cuid())
  code                  String    @unique
  nameEn                String
  namePt                String?
  releaseDate           DateTime?
  officialUrl           String?
  coverImage            String?
  shortDescription      String?   @db.Text
  setType               SetKind   @default(BOOSTER_PACK)
  productCodeAlt        String?
  msrpUsd               Float?
  contentSummaryEn      String?   @db.Text
  contentSummaryPt      String?   @db.Text
  raritySummary         String?   @db.Text
  productNotes          String?   @db.Text
  sourceTitles          String[]
  starterDeckVariantOf  String?
  metadataJson          Json?
  // Nullable de propósito: coleções cadastradas antes do modelo Season existir (ou
  // ainda não classificadas pelo admin) ficam sem season até alguém revisar.
  seasonId              String?
  isActive              Boolean   @default(true)
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  season Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  cards  Card[]

  @@index([seasonId])
}

model TaxonomyEntry {
  id           String       @id @default(cuid())
  kind         TaxonomyKind
  name         String
  slug         String
  description  String?      @db.Text
  // Usados só pra kind=SOURCE_TITLE (séries/mídias) no admin -- capa + link oficial da
  // obra; galeria adicional fica em metadataJson.galleryImages, mesmo padrão do CardSet.
  coverImage   String?
  officialUrl  String?
  metadataJson Json?
  isActive     Boolean      @default(true)
  deletedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([kind, name])
  @@unique([kind, slug])
}

/// Modelo da carta (identidade de jogo — nome, efeito, stats, traits). Compartilhado por
/// todas as impressões (reprint/promo/variante) do mesmo `code`. Ver docs/13-migracao-cardmodel.md.
model CardModel {
  id                String   @id @default(cuid())
  code              String   @unique
  nameEn            String
  namePt            String?
  cardType          CardType
  cardSubtypes      String[]
  color             String?
  level             Int?
  cost              Int?
  ap                Int?
  hp                Int?
  trait             String?
  traits            String[]
  series            String?
  sourceTitle       String?
  zone              String?
  linkText          String?
  pilotName         String?
  effectEn          String?  @db.Text
  effectPt          String?  @db.Text
  triggerKeywords   String[]
  keywordTags       String[]
  effectKeywords    String[]
  textSectionsJson  Json?
  hasBurst          Boolean  @default(false)
  hasMain           Boolean  @default(false)
  hasAction         Boolean  @default(false)
  oncePerTurn       Boolean  @default(false)
  legalityStatus    String?  @default("legal")
  restrictedCopies  Int?
  banGroupId        String?
  isActive          Boolean  @default(true)
  deletedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  prints            Card[]
  outgoingRelations CardRelation[] @relation("CardRelationSourceModel")
  incomingRelations CardRelation[] @relation("CardRelationTargetModel")
  rulings           Ruling[]
  banGroup          CardBanGroup?  @relation(fields: [banGroupId], references: [id])

  @@index([isActive, code])
}

/// Agrupa CardModel que não podem coexistir num mesmo deck além de maxDistinct
/// escolhas diferentes — cobre tanto "par banido" (2 cartas específicas, ver
/// docs/14-motor-regras-deck.md) quanto a regra de categoria genérica oficial
/// (ex: toda unit "Lv.2/custo 1/2AP/2HP sem efeito" é mutuamente incompatível
/// com as outras do grupo, mas até 4 cópias de UMA delas continua permitido).
model CardBanGroup {
  id          String   @id @default(cuid())
  label       String
  maxDistinct Int      @default(1)
  note        String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members CardModel[]
}

model Card {
  id                String   @id @default(cuid())
  code              String
  cardModelId       String?
  externalId        String?  @unique
  nameEn            String
  namePt            String?
  cardType          CardType
  cardSubtypes      String[]
  color             String?
  level             Int?
  cost              Int?
  ap                Int?
  hp                Int?
  rarity            String?
  quantityInProduct Int?
  isPrimaryPrint    Boolean  @default(false)
  printLabel        String?
  trait             String?
  traits            String[]
  series            String?
  sourceTitle       String?
  zone              String?
  linkText          String?
  pilotName         String?
  effectEn          String?  @db.Text
  effectPt          String?  @db.Text
  triggerKeywords   String[]
  keywordTags       String[]
  effectKeywords    String[]
  textSectionsJson  Json?
  hasBurst          Boolean  @default(false)
  hasMain           Boolean  @default(false)
  hasAction         Boolean  @default(false)
  oncePerTurn       Boolean  @default(false)
  imageUrl          String?
  thumbUrl          String?
  imageSmallUrl     String?
  imageMediumUrl    String?
  imageLargeUrl     String?
  imageSourceUrl    String?
  officialUrl       String?
  metadataJson      Json?
  legalityStatus    String?  @default("legal")
  isActive          Boolean  @default(true)
  deletedAt         DateTime?
  setId             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  cardModel         CardModel?         @relation(fields: [cardModelId], references: [id])
  set               CardSet?           @relation(fields: [setId], references: [id])
  deckItems         DeckItem[]
  rulings           Ruling[]
  binderItems       CardBinderItem[]
  deckSnapshotItems DeckSnapshotItem[]

  @@index([code])
  @@index([cardModelId])
  @@index([setId, code])
  @@index([isActive, code])
  @@index([isActive, updatedAt, code])
  @@index([isActive, nameEn, code])
  @@index([isActive, cardType, color])
  @@index([isActive, setId])
  @@index([isActive, rarity, code])
  @@index([isActive, legalityStatus])
  @@index([isActive, ap, code])
  @@index([isActive, hp, code])
  @@index([isActive, cost, code])
  @@index([isActive, level, code])
}

model CardRelation {
  id             String           @id @default(cuid())
  sourceModelId  String
  targetModelId  String
  relationType   CardRelationType
  notePt         String?          @db.Text
  sourceUrl      String?
  isActive       Boolean          @default(true)
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  sourceModel CardModel @relation("CardRelationSourceModel", fields: [sourceModelId], references: [id], onDelete: Cascade)
  targetModel CardModel @relation("CardRelationTargetModel", fields: [targetModelId], references: [id], onDelete: Cascade)

  @@unique([sourceModelId, targetModelId, relationType])
  @@index([sourceModelId, isActive])
  @@index([targetModelId, isActive])
}

model Deck {
  id                String         @id @default(cuid())
  userId            String
  name              String
  format            String         @default("constructed")
  visibility        DeckVisibility @default(PUBLIC)
  notes             String?        @db.Text
  coverImage        String?
  shareId           String         @unique @default(cuid())
  isPrimary         Boolean        @default(false)
  featuredCardIds   String[]       @default([])
  viewCount         Int            @default(0)
  likeCount         Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user                    User                      @relation(fields: [userId], references: [id])
  items                   DeckItem[]
  likes                   DeckLike[]
  views                   DeckView[]
  tournamentEntries       TournamentEntry[]
  deckSnapshots           DeckSnapshot[]
  hostedEventParticipants HostedEventParticipant[]
}

model DeckView {
  id         String   @id @default(cuid())
  deckId     String
  userId     String?
  viewerHash String?
  createdAt  DateTime @default(now())

  deck Deck  @relation(fields: [deckId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([deckId, createdAt])
  @@index([createdAt])
  @@index([viewerHash, deckId])
}

model DeckLike {
  id        String   @id @default(cuid())
  deckId    String
  userId    String
  createdAt DateTime @default(now())

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([deckId, userId])
  @@index([deckId])
  @@index([userId])
}

model DeckItem {
  id       String @id @default(cuid())
  deckId   String
  cardId   String
  quantity Int
  section  String @default("main")

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([deckId, cardId, section])
}

model CardBinder {
  id          String     @id @default(cuid())
  userId      String
  name        String
  description String?    @db.Text
  shareId     String     @unique @default(cuid())
  isPublic    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CardBinderItem[]
}

model CardBinderItem {
  id       String         @id @default(cuid())
  binderId String
  cardId   String
  quantity Int            @default(1)
  note     String?        @db.Text
  position Int            @default(0)
  // Pastas de Coleção Públicas (PublicBinderPage) -- marcação opcional do dono pra sinalizar
  // intenção de troca/desejo na vitrine pública, sem precisar de outro modelo/tabela.
  tag      BinderItemTag?

  binder CardBinder @relation(fields: [binderId], references: [id], onDelete: Cascade)
  card   Card       @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([binderId, cardId])
}

enum BinderItemTag {
  FOR_TRADE
  WISHLIST
}

model Ruling {
  id                String         @id @default(cuid())
  sourceType        RuleSourceType
  title             String
  questionEn        String?        @db.Text
  answerEn          String?        @db.Text
  questionPt        String?        @db.Text
  answerPt          String?        @db.Text
  examplePlayPt     String?        @db.Text
  originalUrl       String?
  relatedKeyword    String?
  relatedPhase      String?
  officialUpdatedAt DateTime?
  translationStatus String?        @default("pending")
  cardId            String?
  cardModelId       String?
  isActive          Boolean        @default(true)
  deletedAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  card      Card?      @relation(fields: [cardId], references: [id])
  cardModel CardModel? @relation(fields: [cardModelId], references: [id])
}

model Tournament {
  id               String            @id @default(cuid())
  name             String
  organizer        String?
  country          String?
  city             String?
  format           String            @default("constructed")
  // Legado: texto livre usado antes do model Season existir. Mantido só pra não
  // perder o rótulo de torneios antigos já cadastrados -- não alimenta mais os
  // filtros novos de metagame, que passam a usar seasonId. Ver seasonId abaixo.
  season           String?
  // Season "de verdade" (relacional). Nullable porque torneios antigos não têm
  // como ser reclassificados com certeza (ver pedido do usuário) -- só torneios
  // novos, ou antigos revisados manualmente pelo admin, carregam esse vínculo.
  seasonId         String?
  sourceUrl        String?
  participantCount Int?
  roundCount       Int?
  topCutSize       Int?
  // Classificação tática pra Central de Eventos (?tab=large_official/small_official/
  // unofficial/ranked/team). Default SMALL_OFFICIAL pra torneios já cadastrados --
  // reclassificação real fica a cargo do admin (ver TournamentTier acima).
  tier             TournamentTier    @default(SMALL_OFFICIAL)
  // Partes do VOD do evento (YouTube), na ordem de exibição -- suporta cobertura
  // dividida em "Part 1", "Part 2" etc. Vazio = sem cobertura de vídeo (layout se
  // adapta, ver critério de aceitação de resiliência a dados parciais).
  vodUrls          String[]          @default([])
  dateStart        DateTime?
  dateEnd          DateTime?
  isActive         Boolean           @default(true)
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  seasonRef Season?           @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  entries   TournamentEntry[]

  @@index([seasonId])
}

model TournamentEntry {
  id           String  @id @default(cuid())
  tournamentId String
  playerName   String
  placement    Int?
  wins         Int?
  losses       Int?
  draws        Int?
  archetype    String?
  deckId       String?
  // Vínculo com conta cadastrada no site -- independente do deck: um jogador pode
  // ter conta e não ter publicado o deck usado nesse evento específico. Cobre
  // "fase 1" do hub de eventos (registrado vs convidado nas estatísticas).
  userId       String?
  // Fase B: cópia congelada da decklist no momento em que o admin vinculou o
  // deckId acima -- resolve o gap de o deckId apontar pro Deck vivo (se o dono
  // editar/apagar o deck depois, o resultado histórico não pode perder a lista).
  deckSnapshotId String?

  tournament   Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  deck         Deck?         @relation(fields: [deckId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  deckSnapshot DeckSnapshot? @relation(fields: [deckSnapshotId], references: [id], onDelete: SetNull)

  deckChangeLogs TournamentEntryDeckChangeLog[]
}

// Auditoria de troca de deck vinculado num TournamentEntry já registrado. O
// TournamentEntry (report retroativo) não trava de forma rígida como o
// HostedEventParticipant -- o admin pode corrigir um vínculo errado a qualquer
// momento -- mas toda troca de deckId fica logada aqui (quem trocou, quando, qual
// era o snapshot anterior) pra manter rastreabilidade de qualquer alteração no
// "deck usado" de um resultado histórico. Ver pedido do usuário: "garantir que os
// decks utilizados em eventos jamais sejam modificados, para manter log".
model TournamentEntryDeckChangeLog {
  id                     String   @id @default(cuid())
  tournamentEntryId      String
  previousDeckId         String?
  previousDeckSnapshotId String?
  nextDeckId             String?
  nextDeckSnapshotId     String?
  changedByUserId        String?
  createdAt              DateTime @default(now())

  tournamentEntry TournamentEntry @relation(fields: [tournamentEntryId], references: [id], onDelete: Cascade)
  changedByUser   User?           @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([tournamentEntryId])
}

// Evento "ao vivo" organizado por um usuário com a flag isHoster (ou um ADMIN),
// diferente do Tournament (que é um report retroativo cadastrado pelo admin).
// Fase A do plano "reorganização do admin + hoster": só o esqueleto do evento
// (dono, local/data/formato/limite de jogadores) e seu ciclo de status. Participantes,
// trava de deck e rodadas/pontuação entram nas fases seguintes.
model HostedEvent {
  id          String            @id @default(cuid())
  hosterId    String
  name        String
  description String?           @db.Text
  format      String            @default("constructed")
  // Season "de verdade" do evento -- opcional (organizador de loja pode não saber
  // classificar na hora), mas é o que passa a alimentar os filtros de metagame por
  // temporada, no lugar do texto livre que o Tournament legado usava.
  seasonId    String?
  venueName   String?
  city        String?
  country     String?
  // Mesma classificação tática do Tournament (ver TournamentTier acima) -- default
  // UNOFFICIAL porque evento ao vivo criado por um Hoster tende a ser liga/local
  // comunitário até o admin reclassificar como oficial sancionado.
  tier        TournamentTier    @default(UNOFFICIAL)
  vodUrls     String[]          @default([])
  dateStart   DateTime
  dateEnd     DateTime?
  maxPlayers  Int?
  status      HostedEventStatus @default(DRAFT)
  isActive    Boolean           @default(true)
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  hoster       User                      @relation(fields: [hosterId], references: [id], onDelete: Cascade)
  seasonRef    Season?                   @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  participants HostedEventParticipant[]
  rounds       HostedEventRound[]

  @@index([hosterId])
  @@index([status])
  @@index([dateStart])
  @@index([seasonId])
}

// Fase B: participante de um HostedEvent -- sempre um usuário cadastrado (diferente
// do TournamentEntry de report, que aceita jogador convidado sem conta). O hoster
// escolhe o deck do participante; uma vez travado (deckSnapshotId preenchido), o
// backend recusa qualquer tentativa de trocar -- a decklist real do evento nunca
// pode ser reescrita depois do fato.
model HostedEventParticipant {
  id             String    @id @default(cuid())
  eventId        String
  userId         String
  deckId         String?
  deckSnapshotId String?
  deckLockedAt   DateTime?
  // Fase 3 (scaffold): arquétipo declarado do participante no evento -- base pra
  // Matriz de Confrontos (ver PLANO_METAGAME_TORNEIOS_TELEMETRIA.md §2.4). Nullable
  // porque hoje não existe fluxo de captura desse dado (próximo passo); enquanto
  // ficar null, o participante simplesmente não entra na matriz de matchups.
  archetype      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  event        HostedEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck         Deck?         @relation(fields: [deckId], references: [id], onDelete: SetNull)
  deckSnapshot DeckSnapshot? @relation(fields: [deckSnapshotId], references: [id], onDelete: SetNull)

  matchesAsA HostedEventMatch[] @relation("MatchParticipantA")
  matchesAsB HostedEventMatch[] @relation("MatchParticipantB")

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

// Fase C: uma rodada de um HostedEvent. Pareamento é manual no MVP (o Hoster monta
// os confrontos à mão) -- roundNumber + status servem tanto pra isso quanto pra uma
// futura rodada gerada automaticamente (Swiss), sem precisar mudar o schema.
model HostedEventRound {
  id          String                 @id @default(cuid())
  eventId     String
  roundNumber Int
  status      HostedEventRoundStatus @default(PENDING)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  event   HostedEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  matches HostedEventMatch[]

  @@unique([eventId, roundNumber])
  @@index([eventId])
}

// Fase C: um confronto dentro de uma rodada. participantB nulo = bye (folga) --
// participantA ganha automaticamente sem afetar o adversário (que não existe).
// O resultado é lançado manualmente pelo Hoster (result começa PENDING);
// reportedAt marca quando o resultado foi de fato lançado.
model HostedEventMatch {
  id             String                 @id @default(cuid())
  roundId        String
  tableNumber    Int?
  participantAId String
  participantBId String?
  result         HostedEventMatchResult @default(PENDING)
  // Fase 3 (scaffold): telemetria de iniciativa pra WR 1st/2nd e Dice WR (ver
  // PLANO_METAGAME_TORNEIOS_TELEMETRIA.md §2.4). Sem relação declarada de propósito
  // (são só ids de referência informativos, não afetam integridade de participantA/B
  // acima) -- sem UI de lançamento ainda, ficam null até existir esse fluxo.
  firstPlayerParticipantId String?
  diceWinnerParticipantId  String?
  reportedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  round        HostedEventRound        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  participantA HostedEventParticipant  @relation("MatchParticipantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantB HostedEventParticipant? @relation("MatchParticipantB", fields: [participantBId], references: [id], onDelete: Cascade)

  @@index([roundId])
  @@index([participantAId])
  @@index([participantBId])
}

// Cópia congelada de uma decklist (cartas + quantidades) no momento em que ela foi
// vinculada a um resultado histórico (TournamentEntry) ou travada num evento do
// Hoster (HostedEventParticipant). Existe pra que a lista exibida nunca mude depois
// -- mesmo que o Deck de origem seja editado ou apagado pelo dono (sourceDeckId e
// sourceUserId ficam null nesse caso, mas os itens da snapshot continuam intactos).
model DeckSnapshot {
  id           String   @id @default(cuid())
  sourceDeckId String?
  sourceUserId String?
  name         String
  format       String?
  compactListJson Json?
  createdAt    DateTime @default(now())

  sourceDeck Deck? @relation(fields: [sourceDeckId], references: [id], onDelete: SetNull)
  sourceUser User? @relation(fields: [sourceUserId], references: [id], onDelete: SetNull)

  items                   DeckSnapshotItem[]
  tournamentEntries       TournamentEntry[]
  hostedEventParticipants HostedEventParticipant[]

  @@index([sourceDeckId])
  @@index([sourceUserId])
}

model DeckSnapshotItem {
  id             String @id @default(cuid())
  deckSnapshotId String
  cardId         String
  quantity       Int
  section        String @default("main")

  deckSnapshot DeckSnapshot @relation(fields: [deckSnapshotId], references: [id], onDelete: Cascade)
  // Restrict (não Cascade como em DeckItem): uma carta não pode ser apagada de
  // verdade enquanto existir numa decklist histórica congelada.
  card         Card         @relation(fields: [cardId], references: [id], onDelete: Restrict)

  @@index([deckSnapshotId])
  @@index([cardId])
}

model Post {
  id          String     @id @default(cuid())
  authorId    String
  title       String
  slug        String     @unique
  excerpt     String?    @db.Text
  contentMd   String     @db.Text
  coverImage  String?
  galleryJson Json?
  youtubeUrl  String?
  postType    PostType
  status      PostStatus @default(DRAFT)
  likeCount   Int        @default(0)
  viewCount   Int        @default(0)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  author   User          @relation(fields: [authorId], references: [id])
  comments PostComment[]
  likes    PostLike[]
}

/// Persistência da partida do Simulador (docs/23). O `matchStore` server-side
/// continua usando um Map em memória como cache de trabalho — esta tabela é o
/// write-through pra a partida SOBREVIVER a restart/deploy/idle do Render.
/// `state` é o `GameState` real (server-side, nunca vai redigido pro cliente).
/// Sem relação FK — é um blob de estado autocontido.
model SimulatorMatch {
  id             String    @id
  state          Json
  seats          Json
  deckKeys       Json
  version        Int       @default(1)
  phase          String
  turnDeadlineAt BigInt?
  lastSeenAt     Json      @default("{}")
  gameOver       Json?
  /// set quando o `GameState` fica com `gameOver` != null — usado pelo índice
  /// pra separar partidas vivas das terminadas (limpeza / futura hidratação em lote).
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([updatedAt])
  @@index([finishedAt])
}

/// Bug report capturado de dentro de uma partida do Simulador (docs/44 Fase 3
/// §5.1). O jogador aperta "Reportar situação" no HUD; o servidor congela o
/// `GameState` completo (repro), o `buildBattleLog` da visão daquele assento e
/// as cartas em jogo no momento. Sem relação FK — blob autocontido, mesma
/// filosofia do `SimulatorMatch`. `shortCode` ("BUG-A1B2C3") é o identificador
/// que o jogador vê na tela e usa pra acompanhar; os agentes de triagem/fix
/// (Wave 3) consomem `status`/`triage`/`prUrl`.
model SimulatorBugReport {
  id            String   @id @default(cuid())
  shortCode     String   @unique
  matchId       String
  reporterId    String
  seat          String
  note          String?
  engineVersion String
  gameState     Json
  battleLog     Json
  lastAction    Json?
  cardsInvolved String[]
  status        String   @default("new")
  triage        Json?
  prUrl         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

/// Fila em Postgres dos turnos do bot heurístico (docs/44 Fase 2 §10.2 — modo
/// treino solo). O web server NUNCA roda a policy do bot inline: quando o motor
/// autoritativo (`matchStore`) fica com a vez no assento do bot, ele só ENFILEIRA
/// uma linha aqui (`status = pending`). O worker dedicado (`services/sim-bot/`)
/// faz polling desta tabela, carrega a partida, roda a heurística em loop até o
/// turno do bot acabar e aplica cada ação de volta pela API autoritativa
/// (`POST /api/simulator/matches/:id/actions`). Sem relação FK — mesma filosofia
/// de blob autocontido do `SimulatorMatch`.
model SimulatorBotTurn {
  id        String   @id @default(cuid())
  matchId   String
  seat      String
  /// pending | processing | done | failed
  status    String   @default("pending")
  attempts  Int      @default(0)
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

/// Log analítico e de treino de partida finalizada no Simulador.
/// Gravado assincronamente ao término da partida para replay determinístico no treino do bot
/// e consolidação de telemetria estatística.
model SimulatorMatchLog {
  id            String   @id @default(cuid())
  matchId       String   @unique
  mode          String   @default("casual")
  deckKeyA      String?
  deckKeyB      String?
  deckA         Json?
  deckB         Json?
  playerAId     String?
  playerBId     String?
  winner        String
  winReason     String
  turns         Int
  durationMs    Int?
  seed          BigInt
  engineVersion String?
  actions       Json
  createdAt     DateTime @default(now())

  @@index([mode])
  @@index([winner])
  @@index([createdAt])
  @@index([deckKeyA, deckKeyB])
}

// ==========================================
// REDE SOCIAL & COMUNIDADE ANAHEIM HUB
// ==========================================

/// Relação de seguidor/seguindo entre pilotos
model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

/// Relação de amizade entre pilotos
model UserFriendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester   User             @relation("FriendshipRequested", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("FriendshipReceived", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId, status])
  @@index([addresseeId, status])
}

/// Mensageria Assíncrona entre pilotos (Estilo E-mail / Caixa Postal - LGPD & Proteção a Menores)
model PilotMailMessage {
  id               String       @id @default(cuid())
  senderId         String
  recipientId      String
  subject          String       @db.VarChar(120)
  content          String       @db.VarChar(1500)
  isRead           Boolean      @default(false)
  readAt           DateTime?
  senderDeleted    Boolean      @default(false)
  recipientDeleted Boolean      @default(false)
  createdAt        DateTime     @default(now())

  sender           User         @relation("SentPilotMail", fields: [senderId], references: [id], onDelete: Cascade)
  recipient        User         @relation("ReceivedPilotMail", fields: [recipientId], references: [id], onDelete: Cascade)
  reports          MailReport[]

  @@index([recipientId, recipientDeleted, isRead, createdAt])
  @@index([senderId, senderDeleted, createdAt])
}

/// Registro de denúncia de mensagem ou conduta de piloto para moderação administrativa
model MailReport {
  id             String       @id @default(cuid())
  reporterId     String
  reportedUserId String
  messageId      String?
  reason         String       @db.VarChar(255)
  details        String?      @db.Text
  status         ReportStatus @default(PENDING)
  adminNotes     String?      @db.Text
  resolvedAt     DateTime?
  resolvedById   String?
  createdAt      DateTime     @default(now())

  reporter       User         @relation("ReportsCreated", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser   User         @relation("ReportsAgainst", fields: [reportedUserId], references: [id], onDelete: Cascade)
  message        PilotMailMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reportedUserId])
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum NotificationType {
  NEW_FOLLOWER
  FRIEND_REQUEST
  FRIEND_ACCEPT
  DECK_LIKE
  NEW_MESSAGE
  BINDER_INTEREST
  ADMIN_REPORT_ALERT
}

/// Notificações e transmissões do sistema
model Notification {
  id          String           @id @default(cuid())
  recipientId String
  actorId     String?
  type        NotificationType
  entityId    String?
  entityType  String?
  message     String
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId, isRead, createdAt])
}

// ==========================================
// MÓDULO EDITORIAL: LIKES & COMENTÁRIOS DE ARTIGOS
// ==========================================

/// Curtidas em artigos publicados
model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

/// Comentários e respostas nos artigos (com suporte a moderação)
model PostComment {
  id            String        @id @default(cuid())
  postId        String
  authorId      String
  parentId      String?
  content       String        @db.Text
  isDeleted     Boolean       @default(false)
  deletedByRole String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  post    Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  PostComment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies PostComment[]     @relation("CommentReplies")
  likes   PostCommentLike[]

  @@index([postId, createdAt])
  @@index([parentId])
  @@index([authorId])
}

/// Curtidas em comentários de artigos
model PostCommentLike {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}





enum SocialPostStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PUBLISHING
  PUBLISHED
  REJECTED
  FAILED
}

enum SocialPostType {
  CARD_SPOTLIGHT
  DECK_FEATURE
  META_INSIGHT
  PRODUCT_AFFILIATE
  TOURNAMENT_REPORT
  ARTICLE
}

/// Fila e historico de postagens para redes sociais com Human-in-the-Loop (Instagram / Discord / Web Admin)
model SocialMediaPost {
  id               String           @id @default(cuid())
  type             SocialPostType   @default(CARD_SPOTLIGHT)
  status           SocialPostStatus @default(PENDING_APPROVAL)
  title            String?
  caption          String           @db.Text
  cardCode         String?
  deckId           String?
  imageUrl         String?
  /// imagens do carrossel, na ordem (a primeira é a capa = imageUrl); vazio = post de imagem única
  mediaUrls        String[]         @default([])
  discordMessageId String?
  instagramPostId  String?
  /// link público do post no Instagram, depois de publicado
  instagramPermalink String?
  /// horário em que o post deve ir ao ar (aprovado antes disso, espera; aprovado depois, sai na hora)
  scheduledFor     DateTime?
  /// dia da agenda (AAAA-MM-DD, horário de Brasília) que gerou o rascunho; impede rascunho duplicado no mesmo dia
  slotKey          String?          @unique
  approvedAt       DateTime?
  publishedAt      DateTime?
  /// último erro ao publicar (mensagem da API do Instagram, sem token)
  publishError     String?
  rejectedReason   String?
  metadata         String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([status, scheduledFor])
}

/// Token de acesso de integrações sociais (Instagram), criptografado com AES-256-GCM.
/// O token do Instagram vale 60 dias e é renovado sozinho; por isso fica no banco e não só no .env.
model SocialIntegrationToken {
  provider    String    @id
  tokenEnc    String    @db.Text
  expiresAt   DateTime?
  refreshedAt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
