generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  EDITOR
  ADMIN
}

enum PostStatus {
  DRAFT
  REVIEW
  PUBLISHED
}

enum PostType {
  NEWS
  PREVIEW
  REVIEW
  GUIDE
}

enum DeckVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum RuleSourceType {
  OFFICIAL_FAQ
  OFFICIAL_RULES
  COMMUNITY_EXPLAINER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  decks Deck[]
  posts Post[]
}

model CardSet {
  id          String   @id @default(cuid())
  code        String   @unique
  nameEn      String
  namePt      String?
  releaseDate DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cards Card[]
}

model Card {
  id            String   @id @default(cuid())
  code          String   @unique
  nameEn        String
  namePt        String?
  cardType      String
  color         String?
  level         Int?
  cost          Int?
  ap            Int?
  hp            Int?
  rarity        String?
  trait         String?
  series        String?
  effectEn      String?  @db.Text
  effectPt      String?  @db.Text
  keywordTags   String[]
  imageUrl       String?
  imageSourceUrl String?
  legalityStatus String? @default("legal")
  setId         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  set       CardSet?      @relation(fields: [setId], references: [id])
  deckItems DeckItem[]
  rulings   Ruling[]
}

model Deck {
  id                String         @id @default(cuid())
  userId            String
  name              String
  format            String         @default("constructed")
  visibility        DeckVisibility @default(PRIVATE)
  notes             String?        @db.Text
  coverImage        String?
  isPrimary         Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user              User              @relation(fields: [userId], references: [id])
  items             DeckItem[]
  tournamentEntries TournamentEntry[]
}

model DeckItem {
  id       String @id @default(cuid())
  deckId   String
  cardId   String
  quantity Int
  section  String @default("main")

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([deckId, cardId, section])
}

model Ruling {
  id                String         @id @default(cuid())
  sourceType        RuleSourceType
  title             String
  questionEn        String?        @db.Text
  answerEn          String?        @db.Text
  questionPt        String?        @db.Text
  answerPt          String?        @db.Text
  examplePlayPt     String?        @db.Text
  relatedKeyword    String?
  relatedPhase      String?
  officialUpdatedAt DateTime?
  translationStatus String?        @default("pending")
  cardId            String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  card Card? @relation(fields: [cardId], references: [id])
}

model Tournament {
  id               String            @id @default(cuid())
  name             String
  organizer        String?
  country          String?
  city             String?
  format           String            @default("constructed")
  season           String?
  sourceUrl        String?
  participantCount Int?
  roundCount       Int?
  topCutSize       Int?
  dateStart        DateTime?
  dateEnd          DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  entries TournamentEntry[]
}

model TournamentEntry {
  id          String  @id @default(cuid())
  tournamentId String
  playerName  String
  placement   Int?
  wins        Int?
  losses      Int?
  draws       Int?
  archetype   String?
  deckId      String?

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  deck       Deck?      @relation(fields: [deckId], references: [id])
}

model Post {
  id          String     @id @default(cuid())
  authorId    String
  title       String
  slug        String     @unique
  excerpt     String?    @db.Text
  contentMd   String     @db.Text
  coverImage  String?
  galleryJson Json?
  youtubeUrl  String?
  postType    PostType
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  author User @relation(fields: [authorId], references: [id])
}
