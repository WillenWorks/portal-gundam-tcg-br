generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum UserRole {
  USER
  EDITOR
  ADMIN
}

enum PostStatus {
  DRAFT
  REVIEW
  PUBLISHED
}

enum PostType {
  NEWS
  PREVIEW
  REVIEW
  GUIDE
}

enum DeckVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum RuleSourceType {
  OFFICIAL_FAQ
  OFFICIAL_RULES
  COMMUNITY_EXPLAINER
}

enum CardLanguage {
  PT_BR
  EN
}

enum HostedEventStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Fase C: status de uma rodada dentro de um HostedEvent.
enum HostedEventRoundStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

// Fase C: resultado de um confronto. BYE é o caso sem participantB (folga --
// vitória automática pro participantA, sem afetar as estatísticas de ninguém
// mais). O MVP é sempre lançado manualmente pelo Hoster; o schema não impede
// que um pareamento automático (Swiss) venha a preencher essas mesmas tabelas
// no futuro.
enum HostedEventMatchResult {
  PENDING
  PLAYER_A_WIN
  PLAYER_B_WIN
  DRAW
  BYE
}

enum SetKind {
  BOOSTER_PACK
  STARTER_DECK
  ACCESSORIES
  PREMIUM_BANDAI
  OTHER
}

enum CardType {
  UNIT
  PILOT
  COMMAND
  COMMAND_PILOT
  BASE
  RESOURCE
  EX_BASE
  EX_RESOURCE
  UNIT_TOKEN
}

enum TaxonomyKind {
  TRAIT
  SOURCE_TITLE
}

enum CardRelationType {
  PILOT_OF
  SUPPORTS
  UPGRADE_OF
  SAME_ARCHETYPE
  STORY_RELATED
}

model User {
  id                    String       @id @default(cuid())
  email                 String       @unique
  googleId              String?      @unique
  displayName           String
  username              String       @unique
  passwordHash          String?
  role                  UserRole     @default(USER)
  isActive              Boolean      @default(true)
  isHoster              Boolean      @default(false)
  preferredCardLanguage CardLanguage @default(PT_BR)
  bio                   String?      @db.Text
  avatarUrl             String?
  preferredTheme        String?      @default("dark")
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  decks                   Deck[]
  posts                   Post[]
  binders                 CardBinder[]
  tournamentEntries       TournamentEntry[]
  hostedEvents            HostedEvent[]
  deckSnapshots           DeckSnapshot[]
  hostedEventParticipants HostedEventParticipant[]
}

model CardSet {
  id                    String    @id @default(cuid())
  code                  String    @unique
  nameEn                String
  namePt                String?
  releaseDate           DateTime?
  officialUrl           String?
  coverImage            String?
  shortDescription      String?   @db.Text
  setType               SetKind   @default(BOOSTER_PACK)
  productCodeAlt        String?
  msrpUsd               Float?
  contentSummaryEn      String?   @db.Text
  contentSummaryPt      String?   @db.Text
  raritySummary         String?   @db.Text
  productNotes          String?   @db.Text
  sourceTitles          String[]
  starterDeckVariantOf  String?
  metadataJson          Json?
  isActive              Boolean   @default(true)
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  cards Card[]
}

model TaxonomyEntry {
  id           String       @id @default(cuid())
  kind         TaxonomyKind
  name         String
  slug         String
  description  String?      @db.Text
  // Usados só pra kind=SOURCE_TITLE (séries/mídias) no admin -- capa + link oficial da
  // obra; galeria adicional fica em metadataJson.galleryImages, mesmo padrão do CardSet.
  coverImage   String?
  officialUrl  String?
  metadataJson Json?
  isActive     Boolean      @default(true)
  deletedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([kind, name])
  @@unique([kind, slug])
}

/// Modelo da carta (identidade de jogo — nome, efeito, stats, traits). Compartilhado por
/// todas as impressões (reprint/promo/variante) do mesmo `code`. Ver docs/13-migracao-cardmodel.md.
model CardModel {
  id                String   @id @default(cuid())
  code              String   @unique
  nameEn            String
  namePt            String?
  cardType          CardType
  cardSubtypes      String[]
  color             String?
  level             Int?
  cost              Int?
  ap                Int?
  hp                Int?
  trait             String?
  traits            String[]
  series            String?
  sourceTitle       String?
  zone              String?
  linkText          String?
  pilotName         String?
  effectEn          String?  @db.Text
  effectPt          String?  @db.Text
  triggerKeywords   String[]
  keywordTags       String[]
  effectKeywords    String[]
  textSectionsJson  Json?
  hasBurst          Boolean  @default(false)
  hasMain           Boolean  @default(false)
  hasAction         Boolean  @default(false)
  oncePerTurn       Boolean  @default(false)
  legalityStatus    String?  @default("legal")
  restrictedCopies  Int?
  banGroupId        String?
  isActive          Boolean  @default(true)
  deletedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  prints            Card[]
  outgoingRelations CardRelation[] @relation("CardRelationSourceModel")
  incomingRelations CardRelation[] @relation("CardRelationTargetModel")
  rulings           Ruling[]
  banGroup          CardBanGroup?  @relation(fields: [banGroupId], references: [id])

  @@index([isActive, code])
}

/// Agrupa CardModel que não podem coexistir num mesmo deck além de maxDistinct
/// escolhas diferentes — cobre tanto "par banido" (2 cartas específicas, ver
/// docs/14-motor-regras-deck.md) quanto a regra de categoria genérica oficial
/// (ex: toda unit "Lv.2/custo 1/2AP/2HP sem efeito" é mutuamente incompatível
/// com as outras do grupo, mas até 4 cópias de UMA delas continua permitido).
model CardBanGroup {
  id          String   @id @default(cuid())
  label       String
  maxDistinct Int      @default(1)
  note        String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members CardModel[]
}

model Card {
  id                String   @id @default(cuid())
  code              String
  cardModelId       String?
  externalId        String?  @unique
  nameEn            String
  namePt            String?
  cardType          CardType
  cardSubtypes      String[]
  color             String?
  level             Int?
  cost              Int?
  ap                Int?
  hp                Int?
  rarity            String?
  quantityInProduct Int?
  isPrimaryPrint    Boolean  @default(false)
  printLabel        String?
  trait             String?
  traits            String[]
  series            String?
  sourceTitle       String?
  zone              String?
  linkText          String?
  pilotName         String?
  effectEn          String?  @db.Text
  effectPt          String?  @db.Text
  triggerKeywords   String[]
  keywordTags       String[]
  effectKeywords    String[]
  textSectionsJson  Json?
  hasBurst          Boolean  @default(false)
  hasMain           Boolean  @default(false)
  hasAction         Boolean  @default(false)
  oncePerTurn       Boolean  @default(false)
  imageUrl          String?
  thumbUrl          String?
  imageSmallUrl     String?
  imageMediumUrl    String?
  imageLargeUrl     String?
  imageSourceUrl    String?
  officialUrl       String?
  metadataJson      Json?
  legalityStatus    String?  @default("legal")
  isActive          Boolean  @default(true)
  deletedAt         DateTime?
  setId             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  cardModel         CardModel?         @relation(fields: [cardModelId], references: [id])
  set               CardSet?           @relation(fields: [setId], references: [id])
  deckItems         DeckItem[]
  rulings           Ruling[]
  binderItems       CardBinderItem[]
  deckSnapshotItems DeckSnapshotItem[]

  @@index([code])
  @@index([cardModelId])
  @@index([setId, code])
  @@index([isActive, code])
  @@index([isActive, updatedAt, code])
  @@index([isActive, nameEn, code])
  @@index([isActive, cardType, color])
  @@index([isActive, setId])
  @@index([isActive, rarity, code])
  @@index([isActive, legalityStatus])
  @@index([isActive, ap, code])
  @@index([isActive, hp, code])
  @@index([isActive, cost, code])
  @@index([isActive, level, code])
}

model CardRelation {
  id             String           @id @default(cuid())
  sourceModelId  String
  targetModelId  String
  relationType   CardRelationType
  notePt         String?          @db.Text
  sourceUrl      String?
  isActive       Boolean          @default(true)
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  sourceModel CardModel @relation("CardRelationSourceModel", fields: [sourceModelId], references: [id], onDelete: Cascade)
  targetModel CardModel @relation("CardRelationTargetModel", fields: [targetModelId], references: [id], onDelete: Cascade)

  @@unique([sourceModelId, targetModelId, relationType])
  @@index([sourceModelId, isActive])
  @@index([targetModelId, isActive])
}

model Deck {
  id                String         @id @default(cuid())
  userId            String
  name              String
  format            String         @default("constructed")
  visibility        DeckVisibility @default(PRIVATE)
  notes             String?        @db.Text
  coverImage        String?
  shareId           String         @unique @default(cuid())
  isPrimary         Boolean        @default(false)
  featuredCardIds   String[]       @default([])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user                    User                      @relation(fields: [userId], references: [id])
  items                   DeckItem[]
  tournamentEntries       TournamentEntry[]
  deckSnapshots           DeckSnapshot[]
  hostedEventParticipants HostedEventParticipant[]
}

model DeckItem {
  id       String @id @default(cuid())
  deckId   String
  cardId   String
  quantity Int
  section  String @default("main")

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([deckId, cardId, section])
}

model CardBinder {
  id          String     @id @default(cuid())
  userId      String
  name        String
  description String?    @db.Text
  shareId     String     @unique @default(cuid())
  isPublic    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CardBinderItem[]
}

model CardBinderItem {
  id       String  @id @default(cuid())
  binderId String
  cardId   String
  quantity Int     @default(1)
  note     String? @db.Text
  position Int     @default(0)

  binder CardBinder @relation(fields: [binderId], references: [id], onDelete: Cascade)
  card   Card       @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([binderId, cardId])
}

model Ruling {
  id                String         @id @default(cuid())
  sourceType        RuleSourceType
  title             String
  questionEn        String?        @db.Text
  answerEn          String?        @db.Text
  questionPt        String?        @db.Text
  answerPt          String?        @db.Text
  examplePlayPt     String?        @db.Text
  originalUrl       String?
  relatedKeyword    String?
  relatedPhase      String?
  officialUpdatedAt DateTime?
  translationStatus String?        @default("pending")
  cardId            String?
  cardModelId       String?
  isActive          Boolean        @default(true)
  deletedAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  card      Card?      @relation(fields: [cardId], references: [id])
  cardModel CardModel? @relation(fields: [cardModelId], references: [id])
}

model Tournament {
  id               String            @id @default(cuid())
  name             String
  organizer        String?
  country          String?
  city             String?
  format           String            @default("constructed")
  season           String?
  sourceUrl        String?
  participantCount Int?
  roundCount       Int?
  topCutSize       Int?
  dateStart        DateTime?
  dateEnd          DateTime?
  isActive         Boolean           @default(true)
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  entries TournamentEntry[]
}

model TournamentEntry {
  id           String  @id @default(cuid())
  tournamentId String
  playerName   String
  placement    Int?
  wins         Int?
  losses       Int?
  draws        Int?
  archetype    String?
  deckId       String?
  // Vínculo com conta cadastrada no site -- independente do deck: um jogador pode
  // ter conta e não ter publicado o deck usado nesse evento específico. Cobre
  // "fase 1" do hub de eventos (registrado vs convidado nas estatísticas).
  userId       String?
  // Fase B: cópia congelada da decklist no momento em que o admin vinculou o
  // deckId acima -- resolve o gap de o deckId apontar pro Deck vivo (se o dono
  // editar/apagar o deck depois, o resultado histórico não pode perder a lista).
  deckSnapshotId String?

  tournament   Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  deck         Deck?         @relation(fields: [deckId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  deckSnapshot DeckSnapshot? @relation(fields: [deckSnapshotId], references: [id], onDelete: SetNull)
}

// Evento "ao vivo" organizado por um usuário com a flag isHoster (ou um ADMIN),
// diferente do Tournament (que é um report retroativo cadastrado pelo admin).
// Fase A do plano "reorganização do admin + hoster": só o esqueleto do evento
// (dono, local/data/formato/limite de jogadores) e seu ciclo de status. Participantes,
// trava de deck e rodadas/pontuação entram nas fases seguintes.
model HostedEvent {
  id          String            @id @default(cuid())
  hosterId    String
  name        String
  description String?           @db.Text
  format      String            @default("constructed")
  venueName   String?
  city        String?
  country     String?
  dateStart   DateTime
  dateEnd     DateTime?
  maxPlayers  Int?
  status      HostedEventStatus @default(DRAFT)
  isActive    Boolean           @default(true)
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  hoster       User                      @relation(fields: [hosterId], references: [id], onDelete: Cascade)
  participants HostedEventParticipant[]
  rounds       HostedEventRound[]

  @@index([hosterId])
  @@index([status])
  @@index([dateStart])
}

// Fase B: participante de um HostedEvent -- sempre um usuário cadastrado (diferente
// do TournamentEntry de report, que aceita jogador convidado sem conta). O hoster
// escolhe o deck do participante; uma vez travado (deckSnapshotId preenchido), o
// backend recusa qualquer tentativa de trocar -- a decklist real do evento nunca
// pode ser reescrita depois do fato.
model HostedEventParticipant {
  id             String    @id @default(cuid())
  eventId        String
  userId         String
  deckId         String?
  deckSnapshotId String?
  deckLockedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  event        HostedEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck         Deck?         @relation(fields: [deckId], references: [id], onDelete: SetNull)
  deckSnapshot DeckSnapshot? @relation(fields: [deckSnapshotId], references: [id], onDelete: SetNull)

  matchesAsA HostedEventMatch[] @relation("MatchParticipantA")
  matchesAsB HostedEventMatch[] @relation("MatchParticipantB")

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

// Fase C: uma rodada de um HostedEvent. Pareamento é manual no MVP (o Hoster monta
// os confrontos à mão) -- roundNumber + status servem tanto pra isso quanto pra uma
// futura rodada gerada automaticamente (Swiss), sem precisar mudar o schema.
model HostedEventRound {
  id          String                 @id @default(cuid())
  eventId     String
  roundNumber Int
  status      HostedEventRoundStatus @default(PENDING)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  event   HostedEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  matches HostedEventMatch[]

  @@unique([eventId, roundNumber])
  @@index([eventId])
}

// Fase C: um confronto dentro de uma rodada. participantB nulo = bye (folga) --
// participantA ganha automaticamente sem afetar o adversário (que não existe).
// O resultado é lançado manualmente pelo Hoster (result começa PENDING);
// reportedAt marca quando o resultado foi de fato lançado.
model HostedEventMatch {
  id             String                 @id @default(cuid())
  roundId        String
  tableNumber    Int?
  participantAId String
  participantBId String?
  result         HostedEventMatchResult @default(PENDING)
  reportedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  round        HostedEventRound        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  participantA HostedEventParticipant  @relation("MatchParticipantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantB HostedEventParticipant? @relation("MatchParticipantB", fields: [participantBId], references: [id], onDelete: Cascade)

  @@index([roundId])
  @@index([participantAId])
  @@index([participantBId])
}

// Cópia congelada de uma decklist (cartas + quantidades) no momento em que ela foi
// vinculada a um resultado histórico (TournamentEntry) ou travada num evento do
// Hoster (HostedEventParticipant). Existe pra que a lista exibida nunca mude depois
// -- mesmo que o Deck de origem seja editado ou apagado pelo dono (sourceDeckId e
// sourceUserId ficam null nesse caso, mas os itens da snapshot continuam intactos).
model DeckSnapshot {
  id           String   @id @default(cuid())
  sourceDeckId String?
  sourceUserId String?
  name         String
  format       String?
  createdAt    DateTime @default(now())

  sourceDeck Deck? @relation(fields: [sourceDeckId], references: [id], onDelete: SetNull)
  sourceUser User? @relation(fields: [sourceUserId], references: [id], onDelete: SetNull)

  items                   DeckSnapshotItem[]
  tournamentEntries       TournamentEntry[]
  hostedEventParticipants HostedEventParticipant[]

  @@index([sourceDeckId])
  @@index([sourceUserId])
}

model DeckSnapshotItem {
  id             String @id @default(cuid())
  deckSnapshotId String
  cardId         String
  quantity       Int
  section        String @default("main")

  deckSnapshot DeckSnapshot @relation(fields: [deckSnapshotId], references: [id], onDelete: Cascade)
  // Restrict (não Cascade como em DeckItem): uma carta não pode ser apagada de
  // verdade enquanto existir numa decklist histórica congelada.
  card         Card         @relation(fields: [cardId], references: [id], onDelete: Restrict)

  @@index([deckSnapshotId])
  @@index([cardId])
}

model Post {
  id          String     @id @default(cuid())
  authorId    String
  title       String
  slug        String     @unique
  excerpt     String?    @db.Text
  contentMd   String     @db.Text
  coverImage  String?
  galleryJson Json?
  youtubeUrl  String?
  postType    PostType
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  author User @relation(fields: [authorId], references: [id])
}
