{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "services/sim-bot/Dockerfile"
  },
  "deploy": {
    "startCommand": "node --import tsx services/sim-bot/index.mjs",
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
