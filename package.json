{
  "name": "portal-gundam-tcg-br",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "deepmerge-ts": ">=8.0.0"
    }
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "vite",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:api:raw": "tsx watch server/index.ts",
    "start": "prisma migrate deploy && tsx server/index.ts",
    "dev:full": "pnpm run dev:api & pnpm run dev",
    "build": "prisma generate && tsc -b && vite build",
    "check:types": "prisma generate && tsc -b",
    "lint": "eslint .",
    "lint:simulator": "eslint src/modules/simulator",
    "test": "vitest run",
    "test:watch": "vitest",
    "gundam:fuzz": "node scripts/gundam-fuzz.mjs",
    "gundam:golden": "node scripts/gundam-golden.mjs",
    "gundam:golden:update": "node scripts/gundam-golden.mjs --update",
    "gundam:selfplay": "node scripts/gundam-fuzz.mjs --policyA=heuristic --policyB=random --games=200 --maxTurns=40",
    "train:dataset": "node scripts/train/dataset.mjs",
    "train:dataset-from-logs": "node scripts/train/dataset-from-logs.mjs",
    "train:fit": "node scripts/train/fit.mjs",
    "train:eval": "node scripts/train/eval.mjs",
    "gundam:index": "node scripts/gundam-index.mjs",
    "gundam:triage": "node scripts/gundam-triage.mjs",
    "gundam:fix": "node scripts/gundam-fix.mjs",
    "catalog:audit": "node scripts/gundam-audit-catalog.mjs",
    "catalog:coverage": "node scripts/gundam-coverage.mjs",
    "catalog:coverage:gate": "node scripts/gundam-coverage.mjs --gate",
    "gundam:coverage": "node scripts/gundam-coverage.mjs",
    "mcp:gundam": "node scripts/mcp-gundam/server.mjs",
    "mcp:gundam:smoke": "node scripts/mcp-gundam/smoke.mjs",
    "sim-bot:start": "node --import tsx services/sim-bot/index.mjs",
    "sim-bot:make-token": "node services/sim-bot/scripts/make-token.mjs",
    "preview": "vite preview",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:reset": "prisma db push --force-reset",
    "prisma:studio": "prisma studio",
    "prisma:seed": "node prisma/seed.mjs",
    "prisma:seed:apitcg": "node prisma/seed-apitcg.mjs",
    "prisma:seed:apitcg:taxonomies": "node prisma/seed-apitcg-taxonomies.mjs",
    "prisma:clear:catalog": "node prisma/clear-catalog.mjs",
    "prisma:rebuild:apitcg": "pnpm run prisma:clear:catalog && pnpm run prisma:seed:apitcg",
    "catalog:apitcg:check": "node scripts/check-apitcg-dataset.mjs",
    "catalog:apitcg:check:taxonomies": "node scripts/check-apitcg-taxonomies.mjs",
    "prisma:reset:seed": "pnpm run prisma:reset && pnpm run prisma:seed",
    "prisma:reset:seed:apitcg": "pnpm run prisma:reset && pnpm run prisma:seed:apitcg",
    "catalog:import": "node scripts/catalog-import.mjs",
    "catalog:import:local": "node scripts/catalog-import.mjs ./data/catalog",
    "curation:gcg:dry-run": "node prisma/apply-gcg-official-curation.mjs",
    "curation:gcg:apply": "node prisma/apply-gcg-official-curation.mjs --apply",
    "keywords:extract:apply": "node prisma/extract-keyword-effects.mjs --apply",
    "catalog:cleanup:phantom-prints": "node prisma/cleanup-phantom-prints.mjs",
    "rulings:import": "node prisma/import-rulings.mjs",
    "rulings:import:apply": "node prisma/import-rulings.mjs --apply",
    "catalog:cleanup:phantom-prints:apply": "node prisma/cleanup-phantom-prints.mjs --apply",
    "catalog:bootstrap": "pnpm run prisma:seed && pnpm run prisma:seed:apitcg && pnpm run cardmodel:migrate:apply && pnpm run curation:gcg:apply && pnpm run keywords:extract:apply && pnpm run banlist:apply && pnpm run catalog:apitcg:check",
    "catalog:bootstrap:fresh": "pnpm run prisma:reset && pnpm run catalog:bootstrap",
    "setup:fresh-env": "pnpm exec prisma generate && pnpm exec prisma migrate deploy && pnpm run catalog:bootstrap",
    "cardmodel:migrate:dry-run": "node prisma/migrate-card-model-data.mjs",
    "cardmodel:migrate:apply": "node prisma/migrate-card-model-data.mjs --apply",
    "cardmodel:validate": "node prisma/validate-card-model-migration.mjs",
    "banlist:dry-run": "node prisma/apply-official-banlist.mjs",
    "banlist:apply": "node prisma/apply-official-banlist.mjs --apply"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.2.1",
    "framer-motion": "^12.43.0",
    "google-auth-library": "^11.0.2",
    "input-otp": "^1.5.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.45.0",
    "multer": "^2.3.0",
    "nanoid": "^5.1.16",
    "react": "^19.3.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.87.0",
    "react-resizable-panels": "^2.1.9",
    "recharts": "^3.10.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.8",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "wouter": "^3.11.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.268",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tensorflow/tfjs": "4.22.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/ui": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}