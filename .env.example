# Prisma local
DATABASE_URL="postgresql://gundam:gundam@localhost:5432/gundam_portal"
# Banco sombra fixo pra `prisma migrate dev` — evita o Prisma ter que criar/derrubar
# um banco temporário a cada migration, o que às vezes falha por instabilidade de
# rede no Docker Desktop do Windows. Precisa existir (CREATE DATABASE gundam_portal_shadow;)
# mas nunca precisa de dado dentro — o Prisma limpa e recria a cada uso.
SHADOW_DATABASE_URL="postgresql://gundam:gundam@localhost:5432/gundam_portal_shadow"

# Database Supabase + Render + Vercel — pega a connection string real no
# painel do Supabase (Project Settings > Database) e cola só no .env local,
# NUNCA aqui no .env.example.
# DATABASE_URL="postgresql://usuario:senha@host.pooler.supabase.com:5432/postgres"

# API / Auth
API_PORT="8787"
# Obrigatório em produção (NODE_ENV=production) — sem valor real, o servidor
# recusa subir. Gere um valor forte, nunca use o placeholder abaixo.
JWT_SECRET="change-this-secret"
SEED_ADMIN_EMAIL="admin@gundambr.local"
# Valor de exemplo só para seed local — troque antes de qualquer deploy real.
SEED_ADMIN_PASSWORD="admin123"

# SEED Online
# SEED_ADMIN_EMAIL="admin@gundamtcg.com"
# SEED_ADMIN_PASSWORD="admin123"

# Vazio em local = CORS aberto, funciona sem configurar nada. Em produção, preenche
# com o domínio real do front-end (separado por vírgula se tiver mais de um), senão
# o navegador bloqueia as chamadas antes de chegar na API. Ver docs/15-deploy-e-login-google.md.
ALLOWED_ORIGINS=""
# Login com Google (opcional) — sem preencher, o botão "Continuar com Google" some
# sozinho no front e a rota /api/auth/google responde "não configurado". Client ID
# vem do Google Cloud Console (OAuth consent screen), ver docs/15-deploy-e-login-google.md.
GOOGLE_CLIENT_ID="1080026338228-qjeml9ic2per7vmm7i0qjgvg1q9mqioi.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="1080026338228-qjeml9ic2per7vmm7i0qjgvg1q9mqioi.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET=""

# Google reCAPTCHA Enterprise (opcional — sem preencher opera em modo permissivo)
VITE_RECAPTCHA_SITE_KEY="6LfAh-otAAAAAHuvUEuB_rDcNSicxJYNdKT183TZ"
RECAPTCHA_SITE_KEY="6LfAh-otAAAAAHuvUEuB_rDcNSicxJYNdKT183TZ"
RECAPTCHA_PROJECT_ID="anaheimhub-portal"
RECAPTCHA_API_KEY=""

# E-mails transacionais (Hostinger SMTP — confirmação de e-mail e recuperação de senha)
# Sem preencher, o servidor roda normalmente e apenas registra os e-mails no log sem falhar.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="admin@anaheimhub.com"
SMTP_PASS="sua-senha-do-email-hostinger"
# Remetente visível (alias nao-responda)
MAIL_FROM="AnaheimHub <nao-responda@anaheimhub.com>"

# Aplicação
VITE_APP_NAME="Portal Gundam TCG BR"
VITE_APP_ENV="local"
VITE_API_BASE_URL="http://localhost:8787/api"
# "1" libera /simulador/preview-layout (sem login) fora do DEV — usar só em
# staging pra iterar o visual do simulador e simular efeitos nos tutoriais.
# Produção deixa em branco.
VITE_LAYOUT_PREVIEW=""

# Cloudflare Web Analytics (gratuito, sem cookies). Opcional: o token do anaheimhub.com já está
# em src/lib/analytics.ts; preencha só para trocar. Só carrega em anaheimhub.com.
VITE_CF_BEACON_TOKEN=""
# Opcional: domínio público onde a API serve /uploads em produção local-like
PUBLIC_APP_URL="http://localhost:8787"

# Storage de imagens
# local: grava em public/uploads e serve pela própria API em /uploads
# supabase: envia para Supabase Storage usando service role no backend
STORAGE_DRIVER="local"
LOCAL_UPLOAD_DIR="public/uploads"
MAX_IMAGE_UPLOAD_MB="8"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="card-images"
# Opcional: CDN/custom domain do bucket público
SUPABASE_STORAGE_PUBLIC_BASE_URL=""

# Futuras integrações IA
ANYGEN_API_KEY=""
OPENAI_API_KEY=""

# Apoio Comunitário via Pix (CommunitySupportModal) — chave, nome e cidade do beneficiário
# vão pro payload "Copia e Cola" (BR Code) que vira o QR Code Pix. Sem preencher, o modal usa
# um placeholder óbvio e um aviso -- nunca inventa uma chave/beneficiário reais.
VITE_PIX_KEY=""
VITE_PIX_MERCHANT_NAME="Anaheim Hub"
VITE_PIX_MERCHANT_CITY="Sao Paulo"
VITE_PIX_PAYLOAD=""

# Simulador — bug report (docs/44 Fase 3 §5.1)
# Token com escopo `repo` (ou fine-grained com permissão "Contents: read/write"
# no repo) usado pra disparar o `repository_dispatch` que acorda o workflow de
# triagem de bug report. VAZIO = o dispatch é só pulado (loga e segue); a
# gravação do SimulatorBugReport continua funcionando normalmente.
GH_DISPATCH_TOKEN=""
# Repo alvo do dispatch — só muda em fork. Default: WillenWorks/portal-gundam-tcg-br
GH_DISPATCH_REPO="WillenWorks/portal-gundam-tcg-br"

# Google AdSense
VITE_ADSENSE_CLIENT_ID="ca-pub-4516039090052126"
